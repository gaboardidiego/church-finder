#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"

trap 'status=$?; if (( status == 0 )); then printf "\nAll checks passed.\n"; else printf "\nChecks failed (exit %s).\n" "$status"; fi' EXIT

run_step() {
  printf '\n==> %s\n' "$1"
  shift
  "$@"
}

for command in npm uv; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$command" >&2
    exit 127
  fi
done

if [[ ! -x "$REPO_ROOT/web/node_modules/.bin/prettier" ]]; then
  printf 'Web dependencies are missing. Run "npm ci" in %s/web first.\n' "$REPO_ROOT" >&2
  exit 1
fi

cd -- "$REPO_ROOT/web"
run_step "Formatting web files" npm run format
run_step "Checking web formatting" npm run format:check
run_step "Linting web files" npm run lint
run_step "Type-checking web files" npm run typecheck
run_step "Running web unit tests" npm run test
run_step "Building the website" npm run build

cd -- "$REPO_ROOT/scraper"
run_step "Formatting Python files" uv run ruff format .
run_step "Checking Python formatting" uv run ruff format --check .
run_step "Linting Python files" uv run ruff check .
run_step "Running Python unit tests" uv run pytest
run_step "Type-checking Python files" uv run ty check src
run_step "Building the Python package" uv build
